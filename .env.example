DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。author = 可读 demo/draft/published；public = 只读 published。
# 不设置时：next dev 为 author，next build / next start 为 public。
# CONTENT_AUDIENCE=author

# Retrieval（search_knowledge 底层；Agent 无需感知）
# bm25 | vector | hybrid；生产默认 bm25（见 README Retrieval Experiment）
RETRIEVAL_MODE=bm25
# 仅在 RETRIEVAL_MODE=vector|hybrid 时需要；默认 bm25 不依赖 embedding
# EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# 若 huggingface.co 超时，可改用镜像：
# HF_ENDPOINT=https://hf-mirror.com
# Hybrid 融合：rrf（默认）或 weighted
# HYBRID_FUSION=rrf
# HYBRID_BM25_WEIGHT=0.45
# HYBRID_VECTOR_WEIGHT=0.55
# HYBRID_RRF_K=60
